# ==============================================================================
# PHOENIX Employee Automation System - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' directory:
#   cp backend/.env.example backend/.env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# --- Gmail SMTP Integration (Required for task assignment notification emails) ---
# The Gmail address from which task notifications will be sent
GMAIL_ADDRESS=your_email@gmail.com

# 16-character Google App Password (NOT your personal Google account password)
# Generated from: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- OpenAI API Integration (Required for AI task email draft generation) ---
# OpenAI API key (begins with 'sk-proj-' or 'sk-')
# Generated from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Flask Session Security (Required in production) ---
# Used to sign session cookies. Generate a strong random value for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated per server restart (sessions lost on restart).
SECRET_KEY=replace_with_a_strong_random_secret_key

# --- Server Settings (Optional) ---
# Default port for PHOENIX backend is 5001
PORT=5001
FLASK_DEBUG=False
