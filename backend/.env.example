# ==============================================================================
# PHOENIX Employee Automation System - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' directory:
#   cp backend/.env.example backend/.env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# --- Gmail SMTP Integration (Required for task assignment notification emails) ---
# The Gmail address from which task notifications will be sent
GMAIL_ADDRESS=your_email@gmail.com

# 16-character Google App Password (NOT your personal Google account password)
# Generated from: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- OpenAI API Integration (Required for AI task email draft generation) ---
# OpenAI API key (begins with 'sk-proj-' or 'sk-')
# Generated from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Flask Session Security (Required in production) ---
# Used to sign session cookies. Generate a strong random value for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated per server restart (sessions lost on restart).
SECRET_KEY=replace_with_a_strong_random_secret_key

# --- Server Settings (Optional) ---
# Default port for PHOENIX backend is 5001
PORT=5001
FLASK_DEBUG=False

# --- Deployment Environment ---
# Set to 'production' to enable SESSION_COOKIE_SECURE and stricter key enforcement
ENVIRONMENT=development

# --- CORS (Required when frontend is hosted on a different origin) ---
# Comma-separated list of trusted frontend origins (no trailing slash, no wildcards)
# Example: https://phoenix-app.onrender.com,https://phoenix.vercel.app
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090

# --- Rate Limiting Storage (Required for multi-worker production deployments) ---
# Defaults to in-memory (lost on restart). Use Redis for persistent limits.
# Example: redis://localhost:6379/0  or  redis://red-xxxx.render.com:6379
RATELIMIT_STORAGE_URI=memory://

# --- JWT Authentication (For cross-origin deployments) ---
# Expiration duration in hours for signed Bearer tokens (default: 24)
JWT_EXPIRY_HOURS=24

# --- Cross-Origin Session Cookies ---
# Set to 'None' for cross-domain hosting (e.g. Render backend + Netlify frontend)
# Set to 'Lax' for same-domain or local development
SESSION_COOKIE_SAMESITE=Lax

# --- Persistent Storage Directory (Optional, for Render Persistent Disks) ---
# Mount point for persistent disk (e.g. /var/data). Defaults to backend/ if unset.
# PHOENIX_DATA_DIR=/var/data

# --- Logging ---
# gunicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info
